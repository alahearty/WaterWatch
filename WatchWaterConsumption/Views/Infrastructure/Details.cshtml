@using WaterWatch.Security
@{
    ViewData["Title"] = "Asset details";
    var canEdit = User.Identity?.IsAuthenticated == true &&
                  (User.IsInRole(Roles.Administrator) || User.IsInRole(Roles.GisAnalyst) || User.IsInRole(Roles.WaterUtilityEngineer));
    var canField = User.Identity?.IsAuthenticated == true &&
                   (User.IsInRole(Roles.Administrator) || User.IsInRole(Roles.FieldInspector) || User.IsInRole(Roles.WaterUtilityEngineer));
}
<div id="asset-detail-root" data-asset-id="@ViewData["AssetId"]">
    <div class="page-head">
        <div>
            <div class="crumbs"><a asp-controller="Infrastructure" asp-action="Index">Infrastructure</a> · Asset details</div>
            <h1 id="asset-name">Loading asset…</h1>
            <p id="asset-subtitle">—</p>
        </div>
        <div class="page-actions">
            <a class="btn" asp-controller="Infrastructure" asp-action="Index"><i class="fa fa-arrow-left"></i> Back</a>
            @if (canEdit)
            {
                <button class="btn btn-primary" id="asset-edit-button" type="button"><i class="fa fa-pencil"></i> Edit asset</button>
            }
        </div>
    </div>
    <div id="asset-availability" class="mb-2"></div>
    <div class="grid grid-main mb-2">
        <div class="card">
            <div class="card-head"><h3>Location</h3><span class="badge badge-outline">EPSG:4326</span></div>
            <div class="card-body flush" style="position:relative;height:380px"><div id="asset-map" style="position:absolute;inset:0"></div></div>
        </div>
        <div class="card">
            <div class="card-head"><h3>Asset record</h3><span id="asset-class"></span></div>
            <div class="card-body" id="asset-facts"><div class="loading-block"><div class="skeleton"></div><div class="skeleton"></div></div></div>
        </div>
    </div>
    <div class="grid grid-2 mb-2">
        <div class="card"><div class="card-head"><h3>Technical specifications</h3></div><div class="card-body"><pre class="code-block" id="asset-specs">—</pre></div></div>
        <div class="card"><div class="card-head"><h3>Source &amp; provenance</h3></div><div class="card-body" id="asset-source">—</div></div>
    </div>
    <div class="grid grid-2 mb-2">
        <div class="card">
            <div class="card-head"><h3>Inspections</h3>@if (canField) { <button class="btn btn-sm" id="add-inspection" type="button"><i class="fa fa-plus"></i> Add inspection</button> }</div>
            <div class="card-body flush" id="asset-inspections"></div>
        </div>
        <div class="card">
            <div class="card-head"><h3>Maintenance history</h3>@if (canField) { <button class="btn btn-sm" id="add-maintenance" type="button"><i class="fa fa-plus"></i> Add record</button> }</div>
            <div class="card-body flush" id="asset-maintenance"></div>
        </div>
    </div>
    <div class="card">
        <div class="card-head"><h3>Documents &amp; photographs</h3><span class="sub">File upload is not enabled in this release</span></div>
        <div class="card-body flush" id="asset-documents"></div>
    </div>
</div>

<div class="modal-backdrop" id="asset-edit-modal">
    <div class="modal wide">
        <div class="modal-head"><h3>Edit asset</h3><button class="close-x" type="button" data-modal-close>&times;</button></div>
        <form id="asset-edit-form">
            <div class="modal-body">
                <div class="field-row">
                    <div class="field"><label>Asset code</label><input class="input" name="assetCode" required /></div>
                    <div class="field"><label>Name</label><input class="input" name="name" required /></div>
                </div>
                <div class="field-row">
                    <div class="field"><label>Type</label><select class="select" name="assetType"></select></div>
                    <div class="field"><label>Status</label><select class="select" name="status"><option>Operational</option><option>UnderMaintenance</option><option>OutOfService</option><option>Decommissioned</option><option>Unknown</option></select></div>
                </div>
                <div class="field-row">
                    <div class="field"><label>Condition</label><select class="select" name="condition"><option>Excellent</option><option>Good</option><option>Fair</option><option>Poor</option><option>Critical</option><option>Unknown</option></select></div>
                    <div class="field"><label>Capacity (m³/day)</label><input class="input" type="number" step="0.01" name="capacityM3PerDay" /></div>
                </div>
                <div class="field"><label>Description</label><textarea class="input" name="description"></textarea></div>
                <div class="field-row">
                    <div class="field"><label>Owner</label><input class="input" name="owner" /></div>
                    <div class="field"><label>Operator</label><input class="input" name="operator" /></div>
                </div>
                <div class="field-row">
                    <div class="field"><label>Installed on</label><input class="input" type="date" name="installedOn" /></div>
                    <div class="field"><label>Source reference</label><input class="input" name="sourceReference" /></div>
                </div>
                <div class="field"><label>Specifications (JSON)</label><textarea class="input" name="specificationsJson"></textarea></div>
                <div class="field"><label>Design parameters (JSON)</label><textarea class="input" name="designParametersJson"></textarea></div>
                <label class="checkbox"><input type="checkbox" name="isSensitive" /> Sensitive infrastructure</label>
            </div>
            <div class="modal-foot"><button class="btn" type="button" data-modal-close>Cancel</button><button class="btn btn-primary" type="submit"><i class="fa fa-save"></i> Save changes</button></div>
        </form>
    </div>
</div>

<div class="modal-backdrop" id="inspection-modal">
    <div class="modal"><div class="modal-head"><h3>Add inspection</h3><button class="close-x" type="button" data-modal-close>&times;</button></div>
        <form id="inspection-form"><div class="modal-body">
            <div class="field"><label>Scheduled for</label><input class="input" type="datetime-local" name="scheduledFor" required /></div>
            <div class="field"><label>Completed at</label><input class="input" type="datetime-local" name="completedAt" /></div>
            <div class="field"><label>Inspector</label><input class="input" name="inspectorName" /></div>
            <div class="field"><label>Findings</label><textarea class="input" name="findings"></textarea></div>
            <div class="field"><label>Condition after inspection</label><select class="select" name="conditionAfter"><option>Unknown</option><option>Excellent</option><option>Good</option><option>Fair</option><option>Poor</option><option>Critical</option></select></div>
        </div><div class="modal-foot"><button class="btn" type="button" data-modal-close>Cancel</button><button class="btn btn-primary" type="submit">Save inspection</button></div></form>
    </div>
</div>

<div class="modal-backdrop" id="maintenance-modal">
    <div class="modal"><div class="modal-head"><h3>Add maintenance record</h3><button class="close-x" type="button" data-modal-close>&times;</button></div>
        <form id="maintenance-form"><div class="modal-body">
            <div class="field"><label>Type</label><select class="select" name="type"><option>Maintenance</option><option>Inspection</option><option>LeakRepair</option><option>Defect</option><option>Other</option></select></div>
            <div class="field"><label>Performed at</label><input class="input" type="datetime-local" name="performedAt" required /></div>
            <div class="field"><label>Performed by</label><input class="input" name="performedBy" /></div>
            <div class="field"><label>Description</label><textarea class="input" name="description"></textarea></div>
            <div class="field"><label>Cost</label><input class="input" type="number" step="0.01" name="cost" /></div>
        </div><div class="modal-foot"><button class="btn" type="button" data-modal-close>Cancel</button><button class="btn btn-primary" type="submit">Save record</button></div></form>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/infrastructure-details.js"></script>
}
